DATA_DIR=./data
APP_PORT=8080
# Leave empty to generate a fresh admin token at each boot.
ADMIN_TOKEN=
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=21474836480
WORKSPACE_QUOTA_BYTES=85899345920
FFPROBE_BIN=ffprobe
# User-selected voice; keep unchanged unless the user requests a different voice.
VOICE_ID=Ngọc Huyền
CLOUD_RATE_VND_PER_HOUR=6000
TARGET_COST_VND_PER_120MIN=5000
GPU_FREE_VRAM_SAFETY_MB=1800
PIPELINE_GENERATION=v2
# Keep disabled until fresh-cloud setup and the private job inputs are ready.
ENABLE_PIPELINE=false
VOICE_REFERENCE=/data/voices/ngoc-huyen.wav
# The launcher reads /data/run/translation.env; do not commit a real key here.
DEEPSEEK_API_KEY=
DEEPSEEK_KEY_FILE=docs/API.txt.txt
# Setup-only read token for the gated Community-1 model; never saved by Git.
HF_TOKEN=
